<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog id="loginDialog" showHeader="false" stretchOnPhone="true"
		contentWidth="23rem" class="stmLoginDlg" escapeHandler=".onLoginEscape">
		<VBox class="stmLoginBox">

			<!-- branded header band -->
			<VBox class="stmLoginHead" alignItems="Center" justifyContent="Center">
				<VBox class="stmLoginLogo" alignItems="Center" justifyContent="Center">
					<Text text="K" class="stmLoginK"/>
				</VBox>
				<Title text="{i18n>headerTitle}" class="stmLoginTitle" wrapping="false"/>
				<Text text="{i18n>headerSub}" class="stmLoginSub"/>
			</VBox>

			<!-- Sign in EITHER by scanning a badge (auto) OR with a PIN + button. -->
			<VBox class="stmLoginForm">
				<Title text="{i18n>loginTitle}" class="stmLoginHeading"/>
				<Text text="{i18n>loginPrompt}" class="stmLoginPrompt"/>

				<!-- 1) Scan a badge: scanning alone signs in, no button press -->
				<Label text="{i18n>loginBadge}" class="stmLoginLbl"/>
				<HBox class="stmField" alignItems="Center">
					<core:Icon src="sap-icon://bar-code" class="stmFieldIcon"/>
					<Input id="loginBadge" type="Password" class="stmFieldInput"
						placeholder="{i18n>loginBadgePh}" submit=".onBadgeScanned">
						<layoutData><FlexItemData growFactor="1"/></layoutData>
					</Input>
				</HBox>

				<Button id="scanBadgeBtn" text="{i18n>scanBadge}" type="Emphasized"
					icon="sap-icon://camera" width="100%" press=".onScanBadge"
					class="stmScanBadgeBtn sapUiTinyMarginTop"/>

				<Text text="{i18n>loginOr}" class="stmLoginOr sapUiSmallMarginTop"/>

				<!-- 2) Or enter a PIN and press Sign in -->
				<Label text="{i18n>loginPin}" class="stmLoginLbl"/>
				<HBox class="stmField" alignItems="Center">
					<core:Icon src="sap-icon://locked" class="stmFieldIcon"/>
					<Input id="loginPin" type="Password" class="stmFieldInput"
						placeholder="{i18n>loginPinPh}" submit=".onLoginSubmit">
						<layoutData><FlexItemData growFactor="1"/></layoutData>
					</Input>
					<core:Icon id="loginEye" src="sap-icon://show" class="stmFieldEye"
						press=".onTogglePass"/>
				</HBox>

				<Button id="loginBtn" text="{i18n>signIn}" type="Default"
					icon="sap-icon://log" width="100%" press=".onLoginSubmit"
					class="stmLoginBtn sapUiTinyMarginTop"/>

				<HBox justifyContent="SpaceBetween" class="stmLoginMeta sapUiSmallMarginTop">
					<Text text="{i18n>loginClient}"/>
					<Text text="{i18n>loginPlant}"/>
				</HBox>

				<HBox class="stmLoginNote sapUiSmallMarginTop">
					<core:Icon src="sap-icon://shield" class="stmLoginNoteIcon"/>
					<Text text="{i18n>loginNote}"/>
				</HBox>
			</VBox>
		</VBox>
	</Dialog>
</core:FragmentDefinition>
