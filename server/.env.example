# Copy to server/.env and fill in real values. server/.env is gitignored.

# --- Web server -------------------------------------------------------------
PORT=8010
# HTTPS is required for the iPad camera scan (Safari blocks camera on http://LAN).
USE_HTTPS=false

# --- SAP client -------------------------------------------------------------
SAP_CLIENT=900

# --- SAP RFC (how the 311 transfer is posted) -------------------------------
# Set SAP_RFC_MOCK=true to run the UI end to end WITHOUT a live SAP system
# (returns a fake material document number). Set false for real posting.
SAP_RFC_MOCK=true

# Classic application-server connection...
SAP_ASHOST=your-sap-app-server-host
SAP_SYSNR=00
SAP_USER=RFC_USER
SAP_PASSWD=changeme
SAP_LANG=EN
# ...or use a saprfc destination from sapnwrfc.ini instead of ashost/sysnr:
# SAP_DEST=

# Goods-movement tuning (defaults are correct for a same-plant SLoc transfer).
SAP_GM_CODE=04          # 04 = MB1B transfer posting
SAP_MOVE_TYPE=311       # 311 = stock-to-stock, SLoc to SLoc, within a plant
SAP_USE_MATERIAL_LONG=true   # true for S/4HANA (MATERIAL_LONG); false for ECC
SAP_HEADER_TXT=ZSTM

# --- QR format --------------------------------------------------------------
# Positional field order when the QR is plain delimited text (labeled
# KEY:VALUE QRs are auto-detected regardless of this). uom is optional.
QR_FIELD_ORDER=plant,sloc,material,batch,qty,uom

# --- Unit of measure --------------------------------------------------------
# The QR carries no unit, so the base unit is read from MARA over HANA when the
# HANA_* vars below are set; otherwise this default is used.
DEFAULT_UOM=

# --- HANA (optional, only for MARA base-unit lookup) ------------------------
HANA_HOST=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=
HANA_ENCRYPT=true
HANA_TIMEOUT_MS=5000
